{
  "name": "madiaget",
  "version": "0.1.24",
  "description": "MediaGet —— 短视频 / 图文 / 音乐统一解析下载站，粘贴分享链接或整段分享文案即得无水印直链。",
  "keywords": [
    "video-parser",
    "video-downloader",
    "douyin",
    "bilibili",
    "kuaishou",
    "xiaohongshu",
    "music",
    "nextjs"
  ],
  "author": "hotier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotier/mediaGet.git"
  },
  "homepage": "https://get.hotier.cc.cd",
  "bugs": {
    "url": "https://github.com/hotier/mediaGet/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:lan": "next dev --turbopack -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:live": "RUN_LIVE_PARSE=1 vitest run tests/live/parse-live.test.ts",
    "test:live:cache": "RUN_LIVE_CACHE=1 vitest run tests/live/music-cache-live.test.ts",
    "test:watch": "vitest",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.5.2",
    "@applemusic-like-lyrics/react": "^0.5.2",
    "@pixi/app": "^7.4.3",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@pixi/filter-blur": "^7.4.3",
    "@pixi/filter-bulge-pinch": "^5.1.1",
    "@pixi/filter-color-matrix": "^7.4.3",
    "@pixi/sprite": "^7.4.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@serwist/next": "^9.5.13",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "serwist": "^9.5.13",
    "tailwindcss": "^3.4.16",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "sharp": "^0.35.0"
  }
}
