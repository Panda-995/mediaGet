{
  "name": "@mediaget/parse-core",
  "version": "1.1.1",
  "type": "module",
  "description": "mediaGet 统一解析内核——web 与桌面端共用的单一代码源（版本化规则见 docs/architecture.md §8，反爬运行时见 §9）。",
  "license": "ISC",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hotier/mediaGet.git",
    "directory": "packages/parse-core"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist --clean",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
